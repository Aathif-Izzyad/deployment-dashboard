<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change & Deployment Tracking Dashboard</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#0284c7',
                            600: '#0284c7',
                            700: '#0369a1',
                            900: '#0c4a6e',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- PapaParse for CSV Parsing -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.05);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(156, 163, 175, 0.5);
            border-radius: 3px;
        }
        .dark ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
        }
        .dark ::-webkit-scrollbar-thumb {
            background: rgba(75, 85, 99, 0.5);
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-100 transition-colors duration-200 min-h-screen flex flex-col">

    <!-- Header / Navbar -->
    <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 sticky top-0 z-30 shadow-sm transition-colors">
        <div class="w-full px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- App Title -->
                <div class="flex items-center space-x-3">
                    <!-- eTiQa Logo Badge -->
                    <div class="w-10 h-10 bg-[#ffcc00] rounded-xl flex items-center justify-center p-1 shadow-sm border border-yellow-400/40 shrink-0">
                        <svg viewBox="0 0 200 200" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                            <!-- eTiQa Text -->
                            <text x="100" y="118" font-family="Inter, system-ui, sans-serif" font-weight="800" font-size="64" fill="#000000" text-anchor="middle" letter-spacing="-1">eTiQa</text>
                            <!-- Smile Arc -->
                            <path d="M 54,128 Q 100,176 146,128 Q 140,118 132,124 Q 100,160 68,124 Q 60,118 54,128 Z" fill="#ffffff"/>
                        </svg>
                    </div>
                    <div>
                        <h1 class="font-bold text-lg leading-tight text-slate-900 dark:text-white">Change & Deployment Tracking Dashboard</h1>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Progress Tracking & Management Dashboard</p>
                    </div>
                </div>

                <!-- Navigation Tabs & Actions -->
                <div class="flex items-center space-x-2 sm:space-x-4">
                    <nav class="flex bg-slate-100 dark:bg-slate-700/60 p-1 rounded-xl text-sm font-medium">
                        <button id="nav-dashboard" onclick="switchTab('dashboard')" class="px-3 sm:px-4 py-1.5 rounded-lg text-sky-600 dark:text-sky-400 bg-white dark:bg-slate-800 shadow-sm transition-all flex items-center space-x-2">
                            <i class="fa-solid fa-chart-pie text-xs"></i>
                            <span class="hidden sm:inline">Dashboard</span>
                        </button>
                        <button id="nav-records" onclick="switchTab('records')" class="px-3 sm:px-4 py-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all flex items-center space-x-2">
                            <i class="fa-solid fa-list-check text-xs"></i>
                            <span class="hidden sm:inline">Change List</span>
                        </button>
                        <button id="nav-add" onclick="switchTab('add')" class="px-3 sm:px-4 py-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all flex items-center space-x-2">
                            <i class="fa-solid fa-plus text-xs"></i>
                            <span>Add New Change/RFC</span>
                        </button>
                    </nav>

                    <!-- Theme Switcher & Refresh -->
                    <div class="flex items-center space-x-1 sm:space-x-2 border-l border-slate-200 dark:border-slate-700 pl-2 sm:pl-4">
                        <button onclick="fetchDataFromUrl()" title="Refresh Data from Google Sheet" class="p-2 text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                            <i id="refresh-icon" class="fa-solid fa-rotate text-sm"></i>
                        </button>
                        <button id="theme-toggle" onclick="toggleDarkMode()" title="Toggle Theme" class="p-2 text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                            <i class="fa-solid fa-moon text-sm dark:hidden"></i>
                            <i class="fa-solid fa-sun text-sm hidden dark:block"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow w-full px-4 sm:px-6 lg:px-8 py-6">

        <!-- Banner / Notification Alert -->
        <div id="status-banner" class="hidden mb-4 p-3 rounded-xl text-xs sm:text-sm flex items-center justify-between border">
            <span id="status-banner-msg"></span>
            <button onclick="document.getElementById('status-banner').classList.add('hidden')" class="ml-2 font-bold">&times;</button>
        </div>

        <!-- Info Notice for Sharing / Autosave -->
        <div class="mb-4 p-3 rounded-xl text-xs sm:text-sm bg-sky-50 dark:bg-sky-950/40 text-sky-800 dark:text-sky-300 border border-sky-200 dark:border-sky-800 flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <i class="fa-solid fa-circle-info"></i>
                <span><strong>Note on Sharing & Data:</strong> Anyone you share this link with will view the same live data fetched directly from the Google Sheet. Local edits or additions made in this browser session are temporary unless updated in your Google Sheet source.</span>
            </div>
        </div>

        <!-- Filters Bar (Shared across Dashboard and Table views) -->
        <div id="filter-section" class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm mb-6 transition-all">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center space-x-2 text-slate-700 dark:text-slate-300 font-semibold text-sm">
                    <i class="fa-solid fa-filter text-sky-500"></i>
                    <span>Filters & Controls</span>
                </div>
                <button onclick="resetFilters()" class="text-xs text-sky-600 dark:text-sky-400 hover:underline flex items-center space-x-1">
                    <i class="fa-solid fa-arrows-rotate text-[10px]"></i>
                    <span>Reset Filters</span>
                </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
                <!-- Search Input -->
                <div class="relative">
                    <i class="fa-solid fa-search absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                    <input type="text" id="filter-search" oninput="applyFilters()" placeholder="Search Title, ID, Jira..." class="w-full pl-8 pr-3 py-1.5 text-xs rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-500">
                </div>

                <!-- Status Filter -->
                <div>
                    <select id="filter-status" onchange="applyFilters()" class="w-full px-3 py-1.5 text-xs rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-500">
                        <option value="">All Statuses</option>
                    </select>
                </div>

                <!-- Phase Filter -->
                <div>
                    <select id="filter-phase" onchange="applyFilters()" class="w-full px-3 py-1.5 text-xs rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-500">
                        <option value="">All Phases</option>
                    </select>
                </div>

                <!-- Category Filter -->
                <div>
                    <select id="filter-category" onchange="applyFilters()" class="w-full px-3 py-1.5 text-xs rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-500">
                        <option value="">All Categories</option>
                    </select>
                </div>

                <!-- Opened By Filter -->
                <div>
                    <select id="filter-opened-by" onchange="applyFilters()" class="w-full px-3 py-1.5 text-xs rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-500">
                        <option value="">All Assignees / Opened By</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- TAB 1: DASHBOARD VIEW -->
        <div id="tab-dashboard" class="space-y-6">
            
            <!-- Key Metrics Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <!-- Total Changes -->
                <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center space-x-4">
                    <div class="p-3 bg-sky-100 dark:bg-sky-950 text-sky-600 dark:text-sky-400 rounded-lg">
                        <i class="fa-solid fa-layer-group text-xl"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Total Changes</p>
                        <h3 id="stat-total" class="text-2xl font-bold text-slate-900 dark:text-white">0</h3>
                    </div>
                </div>

                <!-- Completed / Closed -->
                <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center space-x-4">
                    <div class="p-3 bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 rounded-lg">
                        <i class="fa-solid fa-circle-check text-xl"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Closed</p>
                        <h3 id="stat-completed" class="text-2xl font-bold text-slate-900 dark:text-white">0</h3>
                    </div>
                </div>

                <!-- Initial -->
                <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center space-x-4">
                    <div class="p-3 bg-yellow-400/20 text-yellow-500 rounded-lg">
                        <i class="fa-solid fa-hourglass-half text-xl"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Initial</p>
                        <h3 id="stat-in-progress" class="text-2xl font-bold text-slate-900 dark:text-white">0</h3>
                    </div>
                </div>
            </div>

            <!-- Charts Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Status Chart -->
                <div class="bg-white dark:bg-slate-800 p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-200 flex items-center space-x-2">
                            <i class="fa-solid fa-chart-pie text-sky-500"></i>
                            <span>Status</span>
                        </h3>
                        <div id="status-total-badge" class="text-xs font-semibold px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-600">
                            Total: 0
                        </div>
                    </div>
                    <div class="relative h-64 w-full flex items-center justify-center">
                        <canvas id="chart-status"></canvas>
                    </div>
                </div>

                <!-- Phase Chart -->
                <div class="bg-white dark:bg-slate-800 p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
                    <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-200 mb-4 flex items-center space-x-2">
                        <i class="fa-solid fa-chart-column text-sky-500"></i>
                        <span>Phase</span>
                    </h3>
                    <div class="relative h-64 w-full flex items-center justify-center">
                        <canvas id="chart-phase"></canvas>
                    </div>
                </div>

                <!-- Subcategory Chart -->
                <div class="bg-white dark:bg-slate-800 p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
                    <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-200 mb-4 flex items-center space-x-2">
                        <i class="fa-solid fa-folder-tree text-sky-500"></i>
                        <span>Changes by Subcategory</span>
                    </h3>
                    <div class="relative h-64 w-full flex items-center justify-center">
                        <canvas id="chart-subcategory"></canvas>
                    </div>
                </div>

                <!-- Opened By Chart -->
                <div class="bg-white dark:bg-slate-800 p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
                    <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-200 mb-4 flex items-center space-x-2">
                        <i class="fa-solid fa-user-gear text-sky-500"></i>
                        <span>Opened By</span>
                    </h3>
                    <div class="relative h-64 w-full flex items-center justify-center">
                        <canvas id="chart-openedby"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: DATA RECORDS TABLE (CHANGE LIST) -->
        <div id="tab-records" class="hidden space-y-4">
            <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden">
                <!-- Table Header Actions -->
                <div class="p-3 sm:p-4 border-b border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
                        Showing all <span id="table-count" class="font-bold text-slate-900 dark:text-white">0</span> records
                    </div>
                    <div class="flex items-center space-x-2">
                        <!-- Sort Control Dropdown -->
                        <div class="flex items-center space-x-1 text-xs">
                            <label for="table-sort" class="text-slate-500 dark:text-slate-400 font-medium hidden sm:inline">Sort By:</label>
                            <select id="table-sort" onchange="applyFilters()" class="px-2.5 py-1.5 bg-slate-100 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-200 text-xs rounded-lg font-medium focus:ring-2 focus:ring-sky-500 outline-none">
                                <option value="default">Default Order</option>
                                <option value="id-asc">Change ID (A-Z)</option>
                                <option value="id-desc">Change ID (Z-A)</option>
                                <option value="title-asc">Title (A-Z)</option>
                                <option value="openedBy-asc">Opened By (A-Z)</option>
                                <option value="date-desc">Impl. Date (Newest First)</option>
                                <option value="date-asc">Impl. Date (Oldest First)</option>
                            </select>
                        </div>

                        <button onclick="exportToCSV()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs rounded-lg font-medium transition flex items-center space-x-1.5">
                            <i class="fa-solid fa-download"></i>
                            <span>Export CSV</span>
                        </button>
                    </div>
                </div>

                <!-- Responsive Fit-to-Screen Table Wrapper -->
                <div class="w-full overflow-x-auto">
                    <table class="w-full text-left border-collapse text-[11px] sm:text-xs">
                        <thead>
                            <tr class="bg-[#ffcc00] text-slate-900 uppercase tracking-wider font-extrabold border-b-2 border-yellow-500 shadow-sm">
                                <th class="py-3 px-3 border-r border-yellow-400/80 bg-[#ffcc00] text-center w-12">No.</th>
                                <th class="py-3 px-3 border-r border-yellow-400/80 bg-[#ffcc00]">Change ID</th>
                                <th class="py-3 px-3 border-r border-yellow-400/80 bg-[#ffcc00]">Title</th>
                                <th class="py-3 px-3 border-r border-yellow-400/80 bg-[#ffcc00] hidden md:table-cell">Category</th>
                                <th class="py-3 px-3 border-r border-yellow-400/80 bg-[#ffcc00]">Subcategory</th>
                                <th class="py-3 px-3 border-r border-yellow-400/80 bg-[#ffcc00]">Phase</th>
                                <th class="py-3 px-3 border-r border-yellow-400/80 bg-[#ffcc00]">Status</th>
                                <th class="py-3 px-3 border-r border-yellow-400/80 bg-[#ffcc00] hidden sm:table-cell">Jira Epic</th>
                                <th class="py-3 px-3 border-r border-yellow-400/80 bg-[#ffcc00]">Opened By</th>
                                <th class="py-3 px-3 border-r border-yellow-400/80 bg-[#ffcc00] hidden lg:table-cell">Impl. Date</th>
                                <th class="py-3 px-3 border-r border-yellow-400/80 bg-[#ffcc00]">Impl. Time</th>
                                <th class="py-3 px-3 bg-[#ffcc00] text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="records-tbody" class="divide-y divide-slate-200 dark:divide-slate-700/60 text-slate-700 dark:text-slate-300">
                            <!-- Rows inserted dynamically -->
                        </tbody>
                    </table>
                </div>

                <!-- Empty State -->
                <div id="table-empty-state" class="hidden p-8 text-center text-slate-500 dark:text-slate-400">
                    <i class="fa-solid fa-inbox text-3xl mb-2 text-slate-400"></i>
                    <p class="text-sm">No matching records found.</p>
                </div>
            </div>
        </div>

        <!-- TAB 3: ADD / EDIT DATA FORM -->
        <div id="tab-add" class="hidden max-w-3xl mx-auto">
            <div class="bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
                <div class="mb-6 flex items-center justify-between border-b border-slate-200 dark:border-slate-700 pb-4">
                    <div>
                        <h2 id="form-heading" class="text-base font-bold text-slate-900 dark:text-white">Add New Change Record</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Fill out the details below to add or edit data dynamically in your session.</p>
                    </div>
                    <button id="btn-cancel-edit" onclick="resetForm()" class="hidden px-3 py-1 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs rounded-lg hover:bg-slate-200">Cancel Editing</button>
                </div>

                <form id="change-form" onsubmit="handleFormSubmit(event)" class="space-y-4 text-xs">
                    <input type="hidden" id="form-record-index" value="-1">

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Change ID -->
                        <div>
                            <label class="block font-medium mb-1 text-slate-700 dark:text-slate-300">Change ID <span class="text-rose-500">*</span></label>
                            <input type="text" id="input-change-id" required placeholder="Cxxxxxx" class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 focus:ring-2 focus:ring-sky-500 outline-none">
                        </div>

                        <!-- Opened By -->
                        <div>
                            <label class="block font-medium mb-1 text-slate-700 dark:text-slate-300">Opened By <span class="text-rose-500">*</span></label>
                            <input type="text" id="input-opened-by" required placeholder="Requestor Name" class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 focus:ring-2 focus:ring-sky-500 outline-none">
                        </div>
                    </div>

                    <!-- Title -->
                    <div>
                        <label class="block font-medium mb-1 text-slate-700 dark:text-slate-300">Title <span class="text-rose-500">*</span></label>
                        <input type="text" id="input-title" required placeholder="Title of change..." class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 focus:ring-2 focus:ring-sky-500 outline-none">
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Category -->
                        <div>
                            <label class="block font-medium mb-1 text-slate-700 dark:text-slate-300">Category</label>
                            <input type="text" id="input-category" placeholder="e.g. Infrastructure, Application" class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 focus:ring-2 focus:ring-sky-500 outline-none">
                        </div>

                        <!-- Subcategory -->
                        <div>
                            <label class="block font-medium mb-1 text-slate-700 dark:text-slate-300">Subcategory</label>
                            <input type="text" id="input-subcategory" placeholder="e.g. Enhancement, Error" class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 focus:ring-2 focus:ring-sky-500 outline-none">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <!-- Phase -->
                        <div>
                            <label class="block font-medium mb-1 text-slate-700 dark:text-slate-300">Phase</label>
                            <select id="input-phase" class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 focus:ring-2 focus:ring-sky-500 outline-none">
                                <option value="Change Logging">Change Logging</option>
                                <option value="Change Review">Change Review</option>
                                <option value="Change for Approval">Change for Approval</option>
                                <option value="Change Approval">Change Approval</option>
                                <option value="Change Implementation">Change Implementation</option>
                                <option value="Evaluation & Change Closure">Evaluation & Change Closure</option>
                            </select>
                        </div>

                        <!-- Status -->
                        <div>
                            <label class="block font-medium mb-1 text-slate-700 dark:text-slate-300">Status</label>
                            <select id="input-status" class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 focus:ring-2 focus:ring-sky-500 outline-none">
                                <option value="Initial">Initial</option>
                                <option value="Closed">Closed</option>
                            </select>
                        </div>

                        <!-- Jira Epic -->
                        <div>
                            <label class="block font-medium mb-1 text-slate-700 dark:text-slate-300">Jira Epic</label>
