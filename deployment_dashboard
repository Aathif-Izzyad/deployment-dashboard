    </main>

    <!-- Footer -->
    <footer class="bg-white dark:bg-slate-800 border-t border-slate-200 dark:border-slate-700 py-4 text-xs transition-colors">
        <div class="w-full px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-2">
            <div class="font-normal text-slate-400 dark:text-slate-500 text-left w-full sm:w-auto">
                Created by Muhammad Aathif Izzyad bin Frankie Pilang
            </div>
            <div class="text-right w-full sm:w-auto text-slate-400 dark:text-slate-500">
                Change & Deployment Tracking System
            </div>
        </div>
    </footer>

    <!-- Logic Script -->
    <script>
        const CSV_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vQmynPeooJP8ASzfyUaBuRv84CruztE6q-_tappQXHJJLuk-pKKTYN_np_4iB0c9Affr5KkaBHfUx7X/pub?output=csv';

        // Application State
        let rawData = [];
        let filteredData = [];
        let chartInstances = {};

        // Palette definitions avoiding Yellow & Green
        const COOL_PALETTE = [
            '#0284c7', '#6366f1', '#8b5cf6', '#ec4899', 
            '#06b6d4', '#3b82f6', '#a855f7', '#f43f5e', '#0284c7'
        ];

        // Theme Toggle Functionality
        function toggleDarkMode() {
            const html = document.documentElement;
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
            updateChartsTheme();
        }

        // Initialize Theme preference
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }

        // Tab Switching
        function switchTab(tabName) {
            ['dashboard', 'records', 'add'].forEach(t => {
                const tabEl = document.getElementById(`tab-${t}`);
                if (tabEl) tabEl.classList.add('hidden');
                
                const btn = document.getElementById(`nav-${t}`);
                if (btn) {
                    btn.className = 'px-3 sm:px-4 py-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all flex items-center space-x-2';
                }
            });

            const activeTab = document.getElementById(`tab-${tabName}`);
            if (activeTab) activeTab.classList.remove('hidden');

            const activeBtn = document.getElementById(`nav-${tabName}`);
            if (activeBtn) {
                activeBtn.className = 'px-3 sm:px-4 py-1.5 rounded-lg text-sky-600 dark:text-sky-400 bg-white dark:bg-slate-800 shadow-sm transition-all flex items-center space-x-2 font-semibold';
            }

            if (tabName === 'dashboard') {
                renderCharts();
            }
        }

        // Helper to find column value flexibly regardless of whitespace/case
        function getRowValue(row, possibleKeys) {
            const keys = Object.keys(row);
            for (let target of possibleKeys) {
                const targetClean = target.toLowerCase().replace(/\s+/g, '');
                for (let k of keys) {
                    const kClean = k.toLowerCase().replace(/\s+/g, '');
                    if (kClean === targetClean && row[k] !== undefined && row[k] !== null && String(row[k]).trim() !== '') {
                        return String(row[k]).trim();
                    }
                }
            }
            return '';
        }

        // Helper to parse dynamic Date formats from Google Sheets
        function formatImplDate(val) {
            if (!val || val === 'N/A' || String(val).trim() === '') return 'N/A';
            const cleanVal = String(val).trim();

            let rawDateStr = cleanVal;
            if (cleanVal.includes('T')) {
                rawDateStr = cleanVal.split('T')[0];
            } else if (cleanVal.includes(' ')) {
                rawDateStr = cleanVal.split(' ')[0];
            }

            return parseSingleDateToDDMMYYYY(rawDateStr);
        }

        // Helper to format any date string strictly to DD/MM/YYYY
        function parseSingleDateToDDMMYYYY(dateStr) {
            if (!dateStr || dateStr === 'N/A') return 'N/A';

            if (dateStr.includes('/')) {
                const parts = dateStr.split('/');
                if (parts.length === 3) {
                    let p1 = parts[0].padStart(2, '0');
                    let p2 = parts[1].padStart(2, '0');
                    let year = parts[2].length === 2 ? `20${parts[2]}` : parts[2];
                    
                    if (parseInt(p1, 10) > 12) {
                        return `${p1}/${p2}/${year}`;
                    }
                    if (parseInt(p2, 10) > 12) {
                        return `${p2}/${p1}/${year}`;
                    }
                    return `${p1}/${p2}/${year}`;
                }
            }

            if (dateStr.includes('-')) {
                const parts = dateStr.split('-');
                if (parts.length === 3 && parts[0].length === 4) {
                    const year = parts[0];
                    const month = parts[1].padStart(2, '0');
                    const day = parts[2].padStart(2, '0');
                    return `${day}/${month}/${year}`;
                }
            }

            const d = new Date(dateStr);
            if (!isNaN(d.getTime())) {
                const day = String(d.getDate()).padStart(2, '0');
                const month = String(d.getMonth() + 1).padStart(2, '0');
                const year = d.getFullYear();
                return `${day}/${month}/${year}`;
            }

            return dateStr;
        }

        // Helper to parse dynamic Time formats from Google Sheets
        function formatImplTime(val, fullDateVal) {
            if (val && val !== 'N/A' && String(val).trim() !== '') {
                return String(val).trim();
            }
            if (fullDateVal && String(fullDateVal).trim() !== '') {
                const cleanDate = String(fullDateVal).trim();
                if (cleanDate.includes('T')) {
                    const parts = cleanDate.split('T');
                    if (parts[1]) return parts[1].substring(0, 8).replace('Z', '');
                }
                if (cleanDate.includes(' ')) {
                    const parts = cleanDate.split(' ');
                    if (parts.length > 1) {
                        return parts.slice(1).join(' ');
                    }
                }
            }
            return 'N/A';
        }

        // Fetch Data from Google Sheet CSV
        function fetchDataFromUrl() {
            const refreshIcon = document.getElementById('refresh-icon');
            if (refreshIcon) refreshIcon.classList.add('fa-spin');
            
            showBanner('Fetching updated data from Google Sheets...', 'bg-sky-50 text-sky-800 border-sky-200 dark:bg-sky-900/30 dark:text-sky-300 dark:border-sky-800');

            const cacheBusterUrl = `${CSV_URL}&_t=${Date.now()}`;

            Papa.parse(cacheBusterUrl, {
                download: true,
                header: true,
                skipEmptyLines: true,
                complete: function(results) {
                    if (refreshIcon) refreshIcon.classList.remove('fa-spin');
                    if (results.data && results.data.length > 0) {
                        rawData = results.data.map((row, idx) => {
                            const id = getRowValue(row, ['Change ID', 'change_id', 'ID']) || `C00000${idx+1}`;
                            const openedBy = getRowValue(row, ['Opened By', 'opened_by', 'Requestor', 'Assignee']) || 'N/A';
                            const category = getRowValue(row, ['Category', 'category']) || 'General';
                            const subcategory = getRowValue(row, ['Subcategory', 'subcategory']) || 'General';
                            const title = getRowValue(row, ['Title', 'title', 'Description']) || 'No Title Provided';
                            
                            const rawDate = getRowValue(row, ['Implementation Date', 'impl_date', 'Impl Date', 'Implementation Date/Time', 'Date', 'Implementation Timestamp', 'Timestamp', 'Scheduled Date']);
                            const rawTime = getRowValue(row, ['Implementation Time', 'impl_time', 'Impl Time', 'Time', 'Scheduled Time']);
                            
                            const implDate = formatImplDate(rawDate);
                            const implTime = formatImplTime(rawTime, rawDate);

                            const jiraEpic = getRowValue(row, ['Jira Epic', 'jira_epic', 'Epic', 'Jira']) || 'N/A';
                            const phase = getRowValue(row, ['Phase', 'phase', 'Stage']) || 'Change Logging';
                            const status = normalizeStatus(getRowValue(row, ['Status', 'status']));

                            return { id, openedBy, category, subcategory, title, implDate, implTime, jiraEpic, phase, status };
                        });
                        
                        populateFilterDropdowns();
                        applyFilters();
                        showBanner(`Successfully synced ${rawData.length} records from Google Sheet.`, 'bg-emerald-50 text-emerald-800 border-emerald-200 dark:bg-emerald-900/30 dark:text-emerald-300 dark:border-emerald-800');
                    } else {
                        showBanner('Parsed CSV contained no rows. Loading sample data mode.', 'bg-amber-50 text-amber-800 border-amber-200');
                        loadSampleData();
                    }
                },
                error: function(err) {
                    if (refreshIcon) refreshIcon.classList.remove('fa-spin');
                    console.error('CSV Parsing Error:', err);
                    showBanner('Failed to load Google Sheet data. Using sample data mode.', 'bg-rose-50 text-rose-800 border-rose-200');
                    loadSampleData();
                }
            });
        }

        function normalizeStatus(st) {
            if (!st) return 'Initial';
            const s = String(st).trim().toLowerCase();
            if (s === 'closed' || s === 'close' || s === 'completed') return 'Closed';
            return 'Initial';
        }

        // Fallback Sample Data
        function loadSampleData() {
            rawData = [
                { id: 'C00101', openedBy: 'Muhammad Aathif', category: 'Infrastructure', subcategory: 'Enhancement', title: 'Upgrade PostgreSQL Cluster to v15', implDate: '10/04/2025', implTime: '02:00 AM', jiraEpic: 'EPIC-882', phase: 'Change Implementation', status: 'Initial' },
                { id: 'C00102', openedBy: 'Jane Smith', category: 'Software Development', subcategory: 'Error', title: 'OAuth2 Integration Patch', implDate: '12/04/2025', implTime: '10:30 PM', jiraEpic: 'EPIC-901', phase: 'Evaluation & Change Closure', status: 'Closed' },
                { id: 'C00103', openedBy: 'Alex Johnson', category: 'Networking', subcategory: 'Enhancement', title: 'DMZ Security Rule Update', implDate: '15/04/2025', implTime: '01:15 AM', jiraEpic: 'EPIC-743', phase: 'Change Review', status: 'Initial' },
                { id: 'C00104', openedBy: 'Muhammad Aathif', category: 'Cloud Infrastructure', subcategory: 'Enhancement', title: 'EKS Capacity Expansion', implDate: '18/04/2025', implTime: '04:00 AM', jiraEpic: 'EPIC-1011', phase: 'Change Approval', status: 'Closed' },
                { id: 'C00105', openedBy: 'Sarah Jenkins', category: 'Software Development', subcategory: 'Error', title: 'Stripe API v3 Endpoint Fix', implDate: '20/04/2025', implTime: '11:00 PM', jiraEpic: 'EPIC-612', phase: 'Change Logging', status: 'Initial' }
            ];
            populateFilterDropdowns();
            applyFilters();
        }

        function showBanner(msg, classes) {
            const banner = document.getElementById('status-banner');
            const msgEl = document.getElementById('status-banner-msg');
            if (banner && msgEl) {
                banner.className = `mb-4 p-3 rounded-xl text-xs sm:text-sm flex items-center justify-between border ${classes}`;
                msgEl.textContent = msg;
                banner.classList.remove('hidden');
                setTimeout(() => banner.classList.add('hidden'), 5000);
            }
        }

        // Dynamic Filtering
        function populateFilterDropdowns() {
            const getUnique = (key) => [...new Set(rawData.map(item => item[key]))].filter(Boolean).sort();
            
            fillSelect('filter-status', getUnique('status'), 'All Statuses');
            fillSelect('filter-phase', getUnique('phase'), 'All Phases');
            fillSelect('filter-category', getUnique('category'), 'All Categories');
            fillSelect('filter-opened-by', getUnique('openedBy'), 'All Assignees / Opened By');
        }

        function fillSelect(elementId, options, defaultLabel) {
            const select = document.getElementById(elementId);
            if (!select) return;
            const val = select.value;
            select.innerHTML = `<option value="">${defaultLabel}</option>`;
            options.forEach(opt => {
                select.innerHTML += `<option value="${escapeHtml(opt)}">${escapeHtml(opt)}</option>`;
            });
            select.value = val;
        }

        function applyFilters() {
            const searchVal = document.getElementById('filter-search').value.toLowerCase();
            const statusVal = document.getElementById('filter-status').value;
            const phaseVal = document.getElementById('filter-phase').value;
            const categoryVal = document.getElementById('filter-category').value;
            const openedByVal = document.getElementById('filter-opened-by').value;
            const sortVal = document.getElementById('table-sort') ? document.getElementById('table-sort').value : 'default';

            filteredData = rawData.filter(item => {
                const matchesSearch = !searchVal || 
                    item.id.toLowerCase().includes(searchVal) ||
                    item.title.toLowerCase().includes(searchVal) ||
                    item.jiraEpic.toLowerCase().includes(searchVal) ||
                    item.openedBy.toLowerCase().includes(searchVal);
                
                const matchesStatus = !statusVal || item.status === statusVal;
                const matchesPhase = !phaseVal || item.phase === phaseVal;
                const matchesCategory = !categoryVal || item.category === categoryVal;
                const matchesOpenedBy = !openedByVal || item.openedBy === openedByVal;

                return matchesSearch && matchesStatus && matchesPhase && matchesCategory && matchesOpenedBy;
            });

            // Apply Sorting logic
            if (sortVal === 'id-asc') {
                filteredData.sort((a, b) => a.id.localeCompare(b.id));
            } else if (sortVal === 'id-desc') {
                filteredData.sort((a, b) => b.id.localeCompare(a.id));
            } else if (sortVal === 'title-asc') {
                filteredData.sort((a, b) => a.title.localeCompare(b.title));
            } else if (sortVal === 'openedBy-asc') {
                filteredData.sort((a, b) => a.openedBy.localeCompare(b.openedBy));
            } else if (sortVal === 'date-desc') {
                filteredData.sort((a, b) => {
                    const dateA = a.implDate === 'N/A' ? '' : a.implDate.split('/').reverse().join('');
                    const dateB = b.implDate === 'N/A' ? '' : b.implDate.split('/').reverse().join('');
                    return dateB.localeCompare(dateA);
                });
            } else if (sortVal === 'date-asc') {
                filteredData.sort((a, b) => {
                    const dateA = a.implDate === 'N/A' ? '99999999' : a.implDate.split('/').reverse().join('');
                    const dateB = b.implDate === 'N/A' ? '99999999' : b.implDate.split('/').reverse().join('');
                    return dateA.localeCompare(dateB);
                });
            }

            updateSummaryMetrics();
            renderCharts();
            renderRecordsTable();
        }

        function resetFilters() {
            document.getElementById('filter-search').value = '';
            document.getElementById('filter-status').value = '';
            document.getElementById('filter-phase').value = '';
            document.getElementById('filter-category').value = '';
            document.getElementById('filter-opened-by').value = '';
            if (document.getElementById('table-sort')) document.getElementById('table-sort').value = 'default';
            applyFilters();
        }

        // KPI Summary Metrics
        function updateSummaryMetrics() {
            document.getElementById('stat-total').textContent = filteredData.length;

            const closedCount = filteredData.filter(d => d.status === 'Closed').length;
            const initialCount = filteredData.filter(d => d.status === 'Initial').length;

            document.getElementById('stat-completed').textContent = closedCount;
            document.getElementById('stat-in-progress').textContent = initialCount;
        }

        // Render Dashboard Charts
        function renderCharts() {
            const isDark = document.documentElement.classList.contains('dark');
            const textColor = isDark ? '#94a3b8' : '#475569';
            const gridColor = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.05)';

            const subcategoryPalette = ['#0284c7', '#f97316', '#ec4899'];
            const phasePalette = ['#ec4899', '#f97316', '#0284c7', '#a855f7'];

            let closedCount = 0;
            let initialCount = 0;

            filteredData.forEach(d => {
                if (d.status === 'Closed') {
                    closedCount++;
                } else {
                    initialCount++;
                }
            });

            const totalStatusCount = closedCount + initialCount;

            const badgeEl = document.getElementById('status-total-badge');
            if (badgeEl) {
                badgeEl.textContent = `Total: ${totalStatusCount}`;
            }

            const statusLabels = [`Closed (${closedCount})`, `Initial (${initialCount})`];
            const statusValues = [closedCount, initialCount];
            const statusBackgrounds = ['#10b981', '#facc15'];
            
            createOrUpdateChart('chart-status', 'doughnut', {
                labels: statusLabels,
                datasets: [{
                    data: statusValues,
                    backgroundColor: statusBackgrounds,
                    borderWidth: 2,
                    borderColor: isDark ? '#1e293b' : '#ffffff'
                }]
            }, {
                plugins: { 
                    legend: { 
                        position: 'bottom', 
                        labels: { color: textColor, font: { size: 12, weight: 'bold' } } 
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const val = context.raw || 0;
                                const percentage = totalStatusCount > 0 ? ((val / totalStatusCount) * 100).toFixed(1) : 0;
                                return ` ${context.label}: ${val} (${percentage}%)`;
                            }
                        }
                    }
                }
            });

            const phaseCounts = {};
            filteredData.forEach(d => {
                const p = d.phase || 'Unspecified';
                phaseCounts[p] = (phaseCounts[p] || 0) + 1;
            });

            const phaseLabels = Object.keys(phaseCounts);
            const phaseData = Object.values(phaseCounts);

            createOrUpdateChart('chart-phase', 'bar', {
                labels: phaseLabels,
                datasets: [{
                    label: 'Changes',
                    data: phaseData,
                    backgroundColor: phaseLabels.map((_, i) => phasePalette[i % phasePalette.length]),
                    borderRadius: 6
                }]
            }, {
                plugins: { legend: { display: false } },
                scales: {
                    x: { ticks: { color: textColor, font: { size: 10 } }, grid: { display: false } },
                    y: { ticks: { color: textColor, precision: 0 }, grid: { color: gridColor } }
                }
            });

            const subcatCounts = {};
            filteredData.forEach(d => {
                const sc = d.subcategory || 'General';
                subcatCounts[sc] = (subcatCounts[sc] || 0) + 1;
            });

            createOrUpdateChart('chart-subcategory', 'doughnut', {
                labels: Object.keys(subcatCounts),
                datasets: [{
                    data: Object.values(subcatCounts),
                    backgroundColor: Object.keys(subcatCounts).map((_, i) => subcategoryPalette[i % subcategoryPalette.length]),
                    borderWidth: 2,
                    borderColor: isDark ? '#1e293b' : '#ffffff'
                }]
            }, {
                plugins: { legend: { position: 'bottom', labels: { color: textColor, font: { size: 11 } } } }
            });

            const openedByCounts = {};
            filteredData.forEach(d => {
                const ob = d.openedBy || 'Unknown';
                openedByCounts[ob] = (openedByCounts[ob] || 0) + 1;
            });

            const obLabels = Object.keys(openedByCounts);
            const obData = Object.values(openedByCounts);

            createOrUpdateChart('chart-openedby', 'bar', {
                labels: obLabels,
                datasets: [{
                    label: 'Records Opened',
                    data: obData,
                    backgroundColor: obLabels.map((_, i) => COOL_PALETTE[(i + 2) % COOL_PALETTE.length]),
                    borderRadius: 6
                }]
            }, {
                indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: {
                    x: { ticks: { color: textColor, precision: 0 }, grid: { color: gridColor } },
                    y: { ticks: { color: textColor, font: { size: 10 } }, grid: { display: false } }
                }
            });
        }

        function createOrUpdateChart(canvasId, type, data, options) {
            const canvasEl = document.getElementById(canvasId);
            if (!canvasEl) return;
            if (chartInstances[canvasId]) {
                chartInstances[canvasId].destroy();
            }
            const ctx = canvasEl.getContext('2d');
            chartInstances[canvasId] = new Chart(ctx, {
                type: type,
                data: data,
                options: Object.assign({
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: 400 }
                }, options)
            });
        }

        function updateChartsTheme() {
            if (document.getElementById('tab-dashboard').classList.contains('hidden')) return;
            renderCharts();
        }

        // Render Records Table (Change List)
        function renderRecordsTable() {
            const tbody = document.getElementById('records-tbody');
            const countEl = document.getElementById('table-count');
            const emptyEl = document.getElementById('table-empty-state');

            tbody.innerHTML = '';
            countEl.textContent = filteredData.length;

            if (filteredData.length === 0) {
                emptyEl.classList.remove('hidden');
                return;
            }
            emptyEl.classList.add('hidden');

            filteredData.forEach((item, index) => {
                const originalIndex = rawData.indexOf(item);
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-100/60 dark:hover:bg-slate-800/60 transition-colors border-b border-slate-100 dark:border-slate-800/80';

                let statusBadgeClass = 'background-color: #FFEA00; color: #1e293b; border: 1px solid #eab308;';
                if (item.status === 'Closed') {
                    statusBadgeClass = 'bg-emerald-100 text-emerald-800 border-emerald-300 dark:bg-emerald-950/80 dark:text-emerald-300 dark:border-emerald-700/60';
                }

                // Subcategory color styling
                let subcategoryStyle = 'background-color: #f1f5f9; color: #334155; border: 1px solid #cbd5e1;';
                const subcatClean = (item.subcategory || '').trim().toLowerCase();
                if (subcatClean.includes('enhancement')) {
                    subcategoryStyle = 'background-color: rgba(0, 150, 255, 0.12); color: #0096FF; border: 1px solid rgba(0, 150, 255, 0.3);';
                } else if (subcatClean.includes('error')) {
                    subcategoryStyle = 'background-color: rgba(159, 43, 104, 0.12); color: #9F2B68; border: 1px solid rgba(159, 43, 104, 0.3);';
                }

                let statusTagHtml = `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase border" style="${statusBadgeClass}">${escapeHtml(item.status)}</span>`;
                if (item.status === 'Closed') {
                    statusTagHtml = `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase border ${statusBadgeClass}">${escapeHtml(item.status)}</span>`;
                }

                tr.innerHTML = `
                    <td class="py-2.5 px-3 text-center font-semibold text-slate-500 dark:text-slate-400 whitespace-nowrap">${index + 1}</td>
                    <td class="py-2.5 px-2 font-mono font-semibold text-sky-600 dark:text-sky-400 whitespace-nowrap">${escapeHtml(item.id)}</td>
                    <td class="py-2.5 px-2 font-medium break-words whitespace-normal leading-snug">${escapeHtml(item.title)}</td>
                    <td class="py-2.5 px-2 hidden md:table-cell whitespace-nowrap"><span class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-700/50 text-slate-600 dark:text-slate-300">${escapeHtml(item.category)}</span></td>
                    <td class="py-2.5 px-2 whitespace-nowrap"><span class="px-2 py-0.5 rounded-full font-bold text-[10px] sm:text-xs shadow-sm" style="${subcategoryStyle}">${escapeHtml(item.subcategory)}</span></td>
                    <td class="py-2.5 px-2 whitespace-nowrap text-[10px] sm:text-xs"><span class="px-2 py-0.5 rounded-full font-medium bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-600">${escapeHtml(item.phase)}</span></td>
                    <td class="py-2.5 px-2 whitespace-nowrap">${statusTagHtml}</td>
                    <td class="py-2.5 px-2 hidden sm:table-cell font-mono text-slate-500 dark:text-slate-400 whitespace-nowrap">${escapeHtml(item.jiraEpic)}</td>
                    <td class="py-2.5 px-2 break-words whitespace-normal max-w-[120px] sm:max-w-[160px] font-medium">${escapeHtml(item.openedBy)}</td>
                    <td class="py-2.5 px-2 hidden lg:table-cell whitespace-nowrap text-slate-600 dark:text-slate-400">${escapeHtml(item.implDate)}</td>
                    <td class="py-2.5 px-2 whitespace-nowrap text-slate-600 dark:text-slate-400">${escapeHtml(item.implTime)}</td>
                    <td class="py-2.5 px-2 text-right whitespace-nowrap">
                        <button onclick="editRecord(${originalIndex})" class="p-1.5 text-slate-500 hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400 transition" title="Edit Record">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </button>
                        <button onclick="deleteRecord(${originalIndex})" class="p-1.5 text-slate-500 hover:text-rose-600 dark:text-slate-400 dark:hover:text-rose-400 transition" title="Delete Record">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Form Handlers & Pre-populating Data for Editing
        function editRecord(index) {
            const record = rawData[index];
            if (!record) return;

            document.getElementById('form-record-index').value = index;
            document.getElementById('form-heading').textContent = `Edit Record: ${record.id}`;
            document.getElementById('btn-cancel-edit').classList.remove('hidden');

            document.getElementById('input-change-id').value = record.id;
            document.getElementById('input-opened-by').value = record.openedBy;
            document.getElementById('input-title').value = record.title;
            document.getElementById('input-category').value = record.category;
            document.getElementById('input-subcategory').value = record.subcategory;
            document.getElementById('input-phase').value = record.phase;
            document.getElementById('input-status').value = record.status;
            document.getElementById('input-jira').value = record.jiraEpic;
            document.getElementById('input-date').value = record.implDate;
            document.getElementById('input-time').value = record.implTime;

            switchTab('add');
        }

        function handleFormSubmit(event) {
            event.preventDefault();
            const recordIndex = parseInt(document.getElementById('form-record-index').value, 10);

            const recordData = {
                id: document.getElementById('input-change-id').value.trim(),
                openedBy: document.getElementById('input-opened-by').value.trim(),
                title: document.getElementById('input-title').value.trim(),
                category: document.getElementById('input-category').value.trim() || 'General',
                subcategory: document.getElementById('input-subcategory').value.trim() || 'General',
                phase: document.getElementById('input-phase').value,
                status: document.getElementById('input-status').value,
                jiraEpic: document.getElementById('input-jira').value.trim() || 'N/A',
                implDate: parseSingleDateToDDMMYYYY(document.getElementById('input-date').value.trim()) || 'N/A',
                implTime: document.getElementById('input-time').value.trim() || 'N/A'
            };

            if (recordIndex >= 0 && recordIndex < rawData.length) {
                rawData[recordIndex] = recordData;
                showBanner(`Record ${recordData.id} updated successfully!`, 'bg-emerald-50 text-emerald-800 border-emerald-200');
            } else {
                rawData.unshift(recordData);
                showBanner(`Record ${recordData.id} created successfully!`, 'bg-emerald-50 text-emerald-800 border-emerald-200');
            }

            resetForm();
            populateFilterDropdowns();
            applyFilters();
            switchTab('records');
        }

        function resetForm() {
            document.getElementById('change-form').reset();
            document.getElementById('form-record-index').value = '-1';
            document.getElementById('form-heading').textContent = 'Add New Change Record';
            document.getElementById('btn-cancel-edit').classList.add('hidden');
        }

        function deleteRecord(index) {
            if (index >= 0 && index < rawData.length) {
                const deletedId = rawData[index].id;
                rawData.splice(index, 1);
                populateFilterDropdowns();
                applyFilters();
                showBanner(`Record ${deletedId} deleted successfully.`, 'bg-amber-50 text-amber-800 border-amber-200');
            }
        }

        function exportToCSV() {
            if (!filteredData.length) return;
            const csv = Papa.unparse(filteredData);
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.setAttribute('href', url);
            link.setAttribute('download', `change_deployment_records_${Date.now()}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        window.onload = function () {
            fetchDataFromUrl();
        };
    </script>
</body>
</html>
